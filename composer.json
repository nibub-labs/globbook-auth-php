{
    "name": "nibub-labs/globbook-auth",
    "description": "Official PHP SDK for \"Sign in with Globbook\" OAuth 2.0 — server-side client for the authorization code flow, token exchange, and user info.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "globbook",
        "oauth",
        "oauth2",
        "sign in with globbook",
        "authentication",
        "sdk"
    ],
    "authors": [
        {
            "name": "Nibub"
        }
    ],
    "homepage": "https://github.com/nibub-labs/globbook-auth-php",
    "support": {
        "issues": "https://github.com/nibub-labs/globbook-auth-php/issues",
        "source": "https://github.com/nibub-labs/globbook-auth-php"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Default PSR-18 HTTP client + PSR-17 factories used when you don't supply your own to the Client constructor."
    },
    "autoload": {
        "psr-4": {
            "Globbook\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Globbook\\Auth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "check": [
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
